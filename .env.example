# Copy to .env and edit locally. Never share .env.
DRY_RUN=true
TWILIO_ACCOUNT_SID=AC_REPLACE_LOCALLY
TWILIO_AUTH_TOKEN=REPLACE_LOCALLY
TWILIO_FROM_NUMBER=+REPLACE_WITH_AUTHORIZED_CALLER
ALERT_TO_NUMBER=+212_REPLACE_WITH_YOUR_MOBILE
# Optional: leave empty to escalate to ALERT_TO_NUMBER.
ALERT_BACKUP_NUMBER=
# Optional Zadarma read-only account checker (not the Twilio calling backend).
ZADARMA_KEY=
ZADARMA_SECRET=
